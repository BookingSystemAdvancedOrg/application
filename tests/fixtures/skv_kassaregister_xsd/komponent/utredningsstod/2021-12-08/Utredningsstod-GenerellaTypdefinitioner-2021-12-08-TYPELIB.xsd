<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:utreko="http://xmls.skatteverket.se/se/skatteverket/td/komponent/utredningsstod/1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://xmls.skatteverket.se/se/skatteverket/td/komponent/utredningsstod/1.0" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
 <xs:element name="OrganisationsnummerTEST" type="utreko:OrganisationsnummerTYPE"/>
 <xs:simpleType name="OrganisationsnummerTYPE">
  <xs:restriction base="xs:string">
   <xs:length value="10"/>
   <xs:pattern value="[\d]{2}[2-9]{1}[\d]{7}"/>
  </xs:restriction>
 </xs:simpleType>
 <xs:element name="PersonnummerMedSekelTEST" type="utreko:PersonnummerMedSekelTYPE"/>
 <xs:simpleType name="PersonnummerMedSekelTYPE">
  <xs:restriction base="xs:string">
   <xs:length value="12"/>
   <xs:pattern value="((((19|20)[0-9][0-9])(((01|03|05|07|08|10|12)(0[1-9]|1[0-9]|2[0-9]|3[0-1]))|((04|06|09|11)(0[1-9]|1[0-9]|2[0-9]|30))|((02)(0[1-9]|1[0-9]|2[0-8]))))|(((19|20)(04|08|12|16|20|24|28|32|36|40|44|48|52|56|60|64|68|72|76|80|84|88|92|96)(0229))|(20000229)))(00[1-9]|0[1-9][0-9]|[1-9][0-9][0-9])[0-9]"/>
  </xs:restriction>
 </xs:simpleType>
 <xs:element name="OrganisationsnummerEllerPersonnummerTEST" type="utreko:OrganisationsnummerEllerPersonnummerTYPE"/>
 <xs:simpleType name="OrganisationsnummerEllerPersonnummerTYPE">
  <xs:union memberTypes="utreko:OrganisationsnummerTYPE utreko:PersonnummerMedSekelTYPE"/>
 </xs:simpleType>
 <xs:element name="LopnummerTEST" type="utreko:LopnummerTYPE"/>
 <xs:simpleType name="LopnummerTYPE">
  <xs:restriction base="xs:token">
   <xs:minLength value="1"/>
   <xs:maxLength value="12"/>
   <xs:pattern value="\d*"/>
  </xs:restriction>
 </xs:simpleType>
 <xs:element name="DatumOchKlockslagTEST" type="utreko:DatumOchKlockslagTYPE"/>
 <xs:simpleType name="DatumOchKlockslagTYPE">
  <xs:restriction base="xs:dateTime">
   <xs:pattern value="[2]{1}[0]{1}[1-9]{1}[0-9]{1}.{15}"/>
  </xs:restriction>
 </xs:simpleType>
 <xs:element name="TillverkningsnummerForKontrollenhetenTEST" type="utreko:TillverkningsnummerForKontrollenhetenTYPE"/>
 <xs:simpleType name="TillverkningsnummerForKontrollenhetenTYPE">
  <xs:restriction base="xs:string">
   <xs:length value="17"/>
   <xs:pattern value="([a-z]|[A-Z]|[0-9]|[ ]|[\-])*"/>
  </xs:restriction>
 </xs:simpleType>
 <xs:element name="TillverkningsnummerForKontrollsystemetTEST" type="utreko:TillverkningsnummerForKontrollsystemetTYPE"/>
 <xs:simpleType name="TillverkningsnummerForKontrollsystemetTYPE">
  <xs:restriction base="xs:string">
   <xs:length value="17"/>
   <xs:pattern value="([a-z]|[A-Z]|[0-9]|[ ])*"/>
  </xs:restriction>
 </xs:simpleType>
 <xs:element name="TillverkningsnummerForKassaregistretTEST" type="utreko:TillverkningsnummerForKassaregistretTYPE"/>
 <xs:simpleType name="TillverkningsnummerForKassaregistretTYPE">
  <xs:restriction base="xs:string">
   <xs:maxLength value="48"/>
   <xs:minLength value="1"/>
   <xs:pattern value="(([0-9]|[a-z]|[A-Z]|[\-]){1})(([0-9]|[a-z]|[A-Z]|[\-]|[ ][0-9]|[ ][a-z]|[ ][A-Z]|[ ][\-])*)(([0-9]|[a-z]|[A-Z]|[\-])?)"/>
  </xs:restriction>
 </xs:simpleType>
 <xs:element name="UtlandskValutaTEST" type="utreko:UtlandskValutaTYPE"/>
 <xs:simpleType name="UtlandskValutaTYPE">
  <xs:restriction base="xs:string">
   <xs:minLength value="1"/>
   <xs:maxLength value="72"/>
   <xs:pattern value="([A-Z]|[Å]|[Ä]|[Ö]|[a-z]|[å]|[ä]|[ö])*"/>
  </xs:restriction>
 </xs:simpleType>
</xs:schema>
