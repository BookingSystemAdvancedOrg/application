# Shared, non-secret configuration for dev.yml / prod.yml / reusable_cicd.yml.
#
# Forking this repo for a new AWS account/customer? This is the one file to
# edit - two role ARNs and a region, same pattern as infrastructure's
# project.env. ECR repository URLs and Lambda function names are NOT listed
# here - they're derived at runtime from the assumed role's own AWS account
# ID (via `aws sts get-caller-identity`) + this region + each function's
# folder name under functions/, using the same naming convention
# infrastructure's Terraform uses (prod: "<function>", dev:
# "dev-<function>"). Nothing else needs to change for a fork to deploy as-is.
#
# Loaded into the workflow with the same grep/sed loader infrastructure's
# project.env uses (strips comments, blank lines, CRLF, and value quoting
# before appending to $GITHUB_ENV).

OIDC_ROLE_ARN_PROD=arn:aws:iam::343695380960:role/back-end-deploy-role
OIDC_ROLE_ARN_DEV=arn:aws:iam::877653167825:role/dev-back-end-deploy-role
AWS_REGION=eu-north-1

# Blue/green releases (infrastructure: orchestration/lambda-releases). Every
# function is released through CodeDeploy onto its "live" alias - the alias
# is what API Gateway, streams and schedules invoke, so a plain
# update-function-code would never reach traffic. The result of every
# release is emailed through the alert topic.
CODEDEPLOY_APP_DEV=dev-lambda-releases
CODEDEPLOY_APP_PROD=lambda-releases
ALERT_TOPIC_ARN_DEV=arn:aws:sns:eu-north-1:877653167825:dev-platform-alerts
ALERT_TOPIC_ARN_PROD=arn:aws:sns:eu-north-1:343695380960:platform-alerts

# Post-release smoke test (scripts/smoke-test.sh, source of truth in
# infrastructure/ci). SMOKE_HOST: a restaurant host that always exists
# (GET /site-config?host= must answer 200); empty = an unknown host must
# answer 404 instead. SMOKE_SITES: name=url pairs, each must serve the app
# shell and its script bundle.
API_BASE_URL_DEV=https://dh2m5ildm7.execute-api.eu-north-1.amazonaws.com
API_BASE_URL_PROD=https://9md43vqnp1.execute-api.eu-north-1.amazonaws.com
SMOKE_HOST_DEV=
SMOKE_HOST_PROD=
SMOKE_SITES_DEV="customer=https://d3kaislpxcbglq.cloudfront.net admin=https://restaurang.dev.booqy.se console=https://admin.dev.booqy.se"
SMOKE_SITES_PROD="customer=https://d3uasj29icofcs.cloudfront.net admin=https://restaurang.booqy.se console=https://admin.booqy.se"
