{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://booqy.se/schemas/site/v1.json",
  "title": "Booqy site document v1 (ADR-B)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "theme",
    "nav",
    "pages",
    "footer"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryColor",
        "accentColor",
        "font"
      ],
      "properties": {
        "primaryColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "font": {
          "enum": [
            "serif",
            "sans"
          ]
        }
      }
    },
    "nav": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pageId"
        ],
        "properties": {
          "pageId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "title",
          "seo",
          "blocks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^(|[a-z0-9][a-z0-9-]{0,39})$",
            "description": "'' is the start page."
          },
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "seo": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "description"
            ],
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 70
              },
              "description": {
                "type": "string",
                "maxLength": 160
              }
            }
          },
          "blocks": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type",
                    "heading"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "type": {
                      "const": "hero"
                    },
                    "heading": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 240
                    },
                    "image": {
                      "type": "string",
                      "maxLength": 512,
                      "pattern": "^menu-images/[A-Za-z0-9_-]+/locations/[A-Za-z0-9_-]+/[^\\s]+$",
                      "description": "A key in the tenant's own menu-image prefix."
                    },
                    "cta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "link"
                      ],
                      "properties": {
                        "label": {
                          "type": "string",
                          "maxLength": 40
                        },
                        "link": {
                          "type": "string",
                          "maxLength": 300,
                          "description": "An own page ('page:<pageId>') or an https: URL.",
                          "pattern": "^(page:[a-z0-9][a-z0-9-]{0,39}|https://[^\\s]+)$"
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type",
                    "body"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "type": {
                      "const": "text"
                    },
                    "heading": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "body": {
                      "type": "string",
                      "maxLength": 4000
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type",
                    "image",
                    "alt"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "type": {
                      "const": "image"
                    },
                    "image": {
                      "type": "string",
                      "maxLength": 512,
                      "pattern": "^menu-images/[A-Za-z0-9_-]+/locations/[A-Za-z0-9_-]+/[^\\s]+$",
                      "description": "A key in the tenant's own menu-image prefix."
                    },
                    "alt": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "caption": {
                      "type": "string",
                      "maxLength": 160
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type",
                    "images"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "type": {
                      "const": "gallery"
                    },
                    "heading": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "images": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 12,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "image",
                          "alt"
                        ],
                        "properties": {
                          "image": {
                            "type": "string",
                            "maxLength": 512,
                            "pattern": "^menu-images/[A-Za-z0-9_-]+/locations/[A-Za-z0-9_-]+/[^\\s]+$",
                            "description": "A key in the tenant's own menu-image prefix."
                          },
                          "alt": {
                            "type": "string",
                            "maxLength": 160
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "type": {
                      "const": "menu"
                    },
                    "heading": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "locationId": {
                      "type": "string",
                      "maxLength": 128
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "type": {
                      "const": "openingHours"
                    },
                    "heading": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "locationId": {
                      "type": "string",
                      "maxLength": 128
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "type": {
                      "const": "bookingCta"
                    },
                    "heading": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 240
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 40
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "type": {
                      "const": "orderCta"
                    },
                    "heading": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 240
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 40
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "type": {
                      "const": "cateringCta"
                    },
                    "heading": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 240
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 40
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "type": {
                      "const": "contact"
                    },
                    "heading": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "showMap": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 300
        }
      }
    }
  }
}
